char IR_Number(uint32_t code) {

  if (code == 0xFFA25D) return '1';
  if (code == 0xFF629D) return '2';
  if (code == 0xFFE21D) return '3';
  if (code == 0xFF22DD) return '4';
  if (code == 0xFF02FD) return '5';
  if (code == 0xFFC23D) return '6';
  if (code == 0xFFE01F) return '7';
  if (code == 0xFFA857) return '8';
  if (code == 0xFF906F) return '9';
  if (code == 0xFF9867) return '0';

  return '\0';
}

void Touchpin_Input_Read() {
  int touchpin1_state = digitalRead(TOUCH_PIN1);
  int touchpin2_state = digitalRead(TOUCH_PIN2);
  int touchpin3_state = digitalRead(TOUCH_PIN3);
  int touchpin4_state = digitalRead(TOUCH_PIN4);

  if (touchpin1_state == HIGH) {
    Serial.println("Channel 1 triggered!");
    if (strcmp(current_screen, "menu") == 0) {
      if (strcmp(menu_selection, "apps") == 0) {
        strcpy(menu_selection, "settings");
        Menu_Screen();
      }
    } else if (strcmp(current_screen, "settings") == 0) {
      if (strcmp(settings_selection, "bluetooth") == 0) {
        strcpy(settings_selection, "wifi");
        Settings_Screen();
      }
    } else if (strcmp(current_screen, "wifi_settings") == 0) {
      if (selected_ssid > 0) {
        selected_ssid--;
        Wifi_Settings_Screen();
      }
    }
    delay(500);
  }
  if (touchpin2_state == HIGH) {
    Serial.println("Channel 2 triggered!");
    if (strcmp(current_screen, "menu") == 0) {
      if (strcmp(menu_selection, "settings") == 0) {
        strcpy(menu_selection, "apps");
        Menu_Screen();
      }
    } else if (strcmp(current_screen, "settings") == 0) {
      if (strcmp(settings_selection, "wifi") == 0) {
        strcpy(settings_selection, "bluetooth");
        Settings_Screen();
      }
    } else if (strcmp(current_screen, "wifi_settings") == 0) {
      if (selected_ssid < ssid_count - 1) {
        selected_ssid++;
        Wifi_Settings_Screen();
      }
    }
    delay(500);
  }

  if (touchpin3_state == HIGH) {
    Serial.println("Channel 3 triggered!");
    if (strcmp(current_screen, "menu") == 0) {
      if (strcmp(menu_selection, "settings") == 0) {
        Settings_Screen();
      }
    } else if (strcmp(current_screen, "settings") == 0) {
      if (strcmp(settings_selection, "wifi") == 0) {
        strcpy(wifi_status, "scanning");
        Wifi_Settings_Screen();
      }
    } else if (strcmp(current_screen, "wifi_settings") == 0) {
      if (ssid_count > 0) {
        Serial.print("Selected WiFi: ");
        Serial.println(WiFi.SSID(selected_ssid));
        strcpy(wifi_ssid_text, WiFi.SSID(selected_ssid).c_str());
        Selected_WiFi_Screen();
      }
    }
    delay(500);
  }
  if (touchpin4_state == HIGH) {
    Serial.println("Channel 4 triggered!");

    if (strcmp(current_screen, "home") == 0) {
      Menu_Screen();
    } else if (strcmp(current_screen, "menu") == 0) {
      Home_Screen();
    } else if (strcmp(current_screen, "settings") == 0) {
      Menu_Screen();
    } else if (strcmp(current_screen, "wifi_settings") == 0) {
      Settings_Screen();
    } else if (strcmp(current_screen, "selected_wifi") == 0) {
      entered_wifi_password = "";
      Wifi_Settings_Screen();
    }
    delay(500);
  }
}

void Home_Screen() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setTextColor(SSD1306_WHITE);
  display.getTextBounds(ares_text, 0, 0, &offsetx_ares_text, &offsety_ares_text, &textWidth_ares_text, &textHeight_ares_text);

  int x_ares_text = (SCREEN_WIDTH - textWidth_ares_text) / 2 - offsetx_ares_text;
  int y_ares_text = (SCREEN_HEIGHT - textHeight_ares_text) / 2 - offsety_ares_text;

  display.setCursor(x_ares_text, y_ares_text);
  display.print(ares_text);

  display.setTextSize(1);
  display.getTextBounds(time_text, 0, 0, &offsetx_time_text, &offsety_time_text, &textWidth_time_text, &textHeight_time_text);
  
  int x_time_text = (SCREEN_WIDTH - textWidth_time_text) / 2 - offsetx_time_text;

  display.setCursor(x_time_text, 0);
  display.print(time_text);
  display.display();
  strcpy(current_screen, "home");
}


void Menu_Screen() {
  display.clearDisplay();
