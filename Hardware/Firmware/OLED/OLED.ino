  Serial.begin(115200); 

  Wire.begin(OLED_SDA, OLED_SCL);

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

  pinMode(TOUCH_PIN1, INPUT);
  pinMode(TOUCH_PIN2, INPUT);
  pinMode(TOUCH_PIN3, INPUT);
  pinMode(TOUCH_PIN4, INPUT);

  irrecv.enableIRIn();

  pinMode(IR_LED, OUTPUT);
  irsend.begin();

  Serial.println("IR Transmitter Test");

  display.clearDisplay();

  // Startup
  display.drawBitmap(0, 0, startup_logo, 128, 64, SSD1306_WHITE);
  display.display();

  delay(2500);
  display.clearDisplay();
  // Startup

  //Home Screen
  Home_Screen();
  // Home Screen

}

void loop() {
  Touchpin_Input_Read();

  if (irrecv.decode(&results)) {
    Serial.println(resultToHumanReadableBasic(&results));
    if (strcmp(current_screen, "selected_wifi") == 0) {

      char number = IR_Number(results.value);

      if (number != '\0') {

        entered_wifi_password += number;

        Selected_WiFi_Screen();
      }

      if (results.value == 0xFF38C7) {
        Serial.print("Entered password: ");
        Serial.println(entered_wifi_password);
        Connect_WiFi();
      }
    }

    irrecv.resume();
  }

  irsend.sendNEC(0xFFA25D, 32);

  Serial.println("Sent: 0xFFA25D");

}