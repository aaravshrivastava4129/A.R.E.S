  } else {
    display.print("  Bluetooth");
  }

  display.display();
  strcpy(current_screen, "settings");
}

int scanWifi() {
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  ssid_count = WiFi.scanNetworks();
  strcpy(wifi_status, "scanned");
  Wifi_Settings_Screen();
  return ssid_count;
}

void Wifi_Settings_Screen() {
  int ssid_gap_y = 15;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.getTextBounds(wifi_text, 0, 0, &offsetx_wifi_text, &offsety_wifi_text, &textWidth_wifi_text, &textHeight_wifi_text);
  
  int x_wifi_text = (SCREEN_WIDTH - textWidth_wifi_text) / 2 - offsetx_wifi_text;

  display.setCursor(x_wifi_text, 0);
  display.print(wifi_text);

  display.setCursor(0, 15);
  if (strcmp(wifi_status, "scanning") == 0) {
    display.print("Scanning...");
    display.display();
    scanWifi();
  } else if (strcmp(wifi_status, "scanned") == 0) {

  }

  display.setCursor(0, 15);

  if (ssid_count == 0) {
    display.println("No networks found");
  } else {
    if (selected_ssid < ssid_at_top) {
      ssid_at_top = selected_ssid;
    } else if (selected_ssid >= ssid_at_top + max_visible_ssid) {
      ssid_at_top = selected_ssid - max_visible_ssid + 1;
    }

    for (i = ssid_at_top; i < ssid_count && i < ssid_at_top + max_visible_ssid; ++i) {
      display.setCursor(0, ssid_gap_y);

      if (i == selected_ssid) {
        display.print("> ");
      } else {
        display.print("  ");
      }

      display.println(WiFi.SSID(i));
      ssid_gap_y += 15;
      delay(10);
    } 
  }

  display.display();
  
  strcpy(current_screen, "wifi_settings");
}

void Selected_WiFi_Screen() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.getTextBounds(wifi_ssid_text, 0, 0, &offsetx_wifi_ssid_text, &offsety_wifi_ssid_text, &textWidth_wifi_ssid_text, &textHeight_wifi_ssid_text);
  
  int x_wifi_ssid_text = (SCREEN_WIDTH - textWidth_wifi_ssid_text) / 2 - offsetx_wifi_ssid_text;

  display.setCursor(x_wifi_ssid_text, 0);
  display.print(wifi_ssid_text);

  display.drawRect(0, 18, 128, 25, SSD1306_WHITE);

  display.setCursor(4, 27);

  // Show entered password
  display.print(entered_wifi_password);
  display.display();

  strcpy(current_screen, "selected_wifi");
}

void Connect_WiFi() {

  Serial.print("Connecting to: ");
  Serial.println(WiFi.SSID(selected_ssid));

  WiFi.begin(WiFi.SSID(selected_ssid).c_str(), entered_wifi_password.c_str());

  unsigned long startTime = millis();

  while (WiFi.status() != WL_CONNECTED && millis() - startTime < 10000) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    
    display.getTextBounds(wifi_ssid_text, 0, 0, &offsetx_wifi_ssid_text, &offsety_wifi_ssid_text, &textWidth_wifi_ssid_text, &textHeight_wifi_ssid_text);
    int x_wifi_ssid_text = (SCREEN_WIDTH - textWidth_wifi_ssid_text) / 2 - offsetx_wifi_ssid_text;
    
    display.setCursor(x_wifi_ssid_text, 0);
    display.print(wifi_ssid_text);
    
    display.setTextSize(2);
    display.setCursor(0, 30);
    display.println("CONNECTING..");
    display.display();
    delay(500);
    }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("Connected!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    strcpy(wifi_connection, "connected");
    entered_wifi_password = "";
    WiFi_Connection_Success_Screen();
  } else {

    Serial.println("Wrong password / connection failed");
    WiFi.disconnect();
    strcpy(wifi_connection, "disconnected");
    entered_wifi_password = "";
    WiFi_Connection_Failed_Screen();
  }
}

void WiFi_Connection_Success_Screen() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.getTextBounds(wifi_ssid_text, 0, 0, &offsetx_wifi_ssid_text, &offsety_wifi_ssid_text, &textWidth_wifi_ssid_text, &textHeight_wifi_ssid_text);
  
  int x_wifi_ssid_text = (SCREEN_WIDTH - textWidth_wifi_ssid_text) / 2 - offsetx_wifi_ssid_text;

  display.setCursor(x_wifi_ssid_text, 0);
  display.print(wifi_ssid_text);

  display.setTextSize(2);
  display.setCursor(0, 30);
  display.print("CONNECTED");
  strcpy(current_screen, "wifi_connected");
  display.display();
  delay(1500);
  Wifi_Settings_Screen();
}

void WiFi_Connection_Failed_Screen() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.getTextBounds(wifi_ssid_text, 0, 0, &offsetx_wifi_ssid_text, &offsety_wifi_ssid_text, &textWidth_wifi_ssid_text, &textHeight_wifi_ssid_text);
  
  int x_wifi_ssid_text = (SCREEN_WIDTH - textWidth_wifi_ssid_text) / 2 - offsetx_wifi_ssid_text;

  display.setCursor(x_wifi_ssid_text, 0);
  display.print(wifi_ssid_text);

  display.setTextSize(2);
  display.setCursor(0, 30);
  display.println("COULD'NT");
  display.println("CONNECT");
  strcpy(current_screen, "wifi_not_connected");
  display.display();
  delay(1500);
  Wifi_Settings_Screen();
}

